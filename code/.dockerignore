# Never send local credentials to the Docker daemon. Keep the committed
# template available to builds and documentation tooling.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example
.envrc
**/.envrc
.npmrc
**/.npmrc
.pypirc
**/.pypirc
.netrc
**/.netrc
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
id_rsa
**/id_rsa
id_dsa
**/id_dsa
id_ecdsa
**/id_ecdsa
id_ed25519
**/id_ed25519
credentials.json
**/credentials.json

# Version-control and local development state.
.git/
.gitignore
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
*.pyo
**/*.pyo
.venv/
**/.venv/
.venv-linux/
**/.venv-linux/
.lab-backup/
.lab-backup.tmp.*
.lab-restore.tmp.*
*.egg-info/
**/*.egg-info/
node_modules/
**/node_modules/
dist/
**/dist/
.runtime/
**/.runtime/
*.tsbuildinfo
**/*.tsbuildinfo
.coverage
**/.coverage
coverage/
**/coverage/
htmlcov/
**/htmlcov/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
*.log
**/*.log
.DS_Store
**/.DS_Store
