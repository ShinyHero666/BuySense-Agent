# Never put raw model-provider keys here; use only a scoped ModelPort client key.
MOYUAN_MODELPORT_BASE_URL=http://127.0.0.1:38082
MOYUAN_MODELPORT_HEALTH_URL=http://127.0.0.1:38082/livez
MOYUAN_MODELPORT_API_KEY=replace-with-a-scoped-modelport-client-key
MOYUAN_MODELPORT_MODEL=moyuan-shoprec-agent
MOYUAN_MODELPORT_TIMEOUT_SECONDS=30
MOYUAN_MODELPORT_MAX_COMPLETION_TOKENS=512
MOYUAN_MODELPORT_ROUTING_PROFILE=balanced
# The Pi control plane hard-codes local_strict + internal for this local-Qwen path.
MOYUAN_AGENT_MODEL_MODE=modelport

# TypeScript/Pi control-plane discovery source: memory or python.
MOYUAN_DISCOVERY_MODE=python
# 18080 belongs to local-inference-stack on the maintained WSL setup.
MOYUAN_DISCOVERY_BASE_URL=http://127.0.0.1:18083
MOYUAN_CONTROL_HOST=127.0.0.1
MOYUAN_CONTROL_PORT=19090
MOYUAN_DATABASE_PATH=.runtime/commerce-agent.sqlite

# Retail catalog/price/review provider. `static` is deterministic and makes no
# upstream HTTP requests. In `http` mode select `generic` or `shopify`; fallback
# is fail-closed by default and must be enabled explicitly.
MOYUAN_RETAIL_DATA_MODE=static
MOYUAN_RETAIL_DATA_PROVIDER=generic
MOYUAN_RETAIL_DATA_FALLBACK_ENABLED=false
MOYUAN_RETAIL_DATA_TIMEOUT_SECONDS=2
MOYUAN_RETAIL_DATA_MAX_RESPONSE_BYTES=1048576
# Plain HTTP is accepted for loopback only unless this development-only switch is true.
MOYUAN_RETAIL_DATA_ALLOW_INSECURE_HTTP=false
# The generic provider requires its own HTTPS base URL and an optional scoped key.
# MOYUAN_RETAIL_DATA_BASE_URL=https://retail-data.internal.example
# Retail credentials must likewise be scoped and read-only.
# MOYUAN_RETAIL_DATA_API_KEY=replace-with-a-scoped-read-only-key

# Optional Shopify provider and its independent connectivity canary. M4 supports
# one store with a dedicated custom-app Admin token carrying `read_products` and
# no `write_*` scopes. The supported Admin API contract is pinned to 2026-07.
MOYUAN_SHOPIFY_API_VERSION=2026-07
MOYUAN_SHOPIFY_CANARY_TIMEOUT_SECONDS=5
MOYUAN_SHOPIFY_CANARY_MAX_RESPONSE_BYTES=262144
# MOYUAN_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# MOYUAN_SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-a-scoped-read-only-token
