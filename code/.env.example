# The Agent receives only a ModelPort client key. Never put Provider keys here.
MOYUAN_MODELPORT_BASE_URL=http://127.0.0.1:38082
MOYUAN_MODELPORT_HEALTH_URL=http://127.0.0.1:38082/livez
MOYUAN_MODELPORT_API_KEY=replace-with-a-scoped-modelport-client-key
MOYUAN_MODELPORT_MODEL=moyuan-shoprec-agent
MOYUAN_MODELPORT_TIMEOUT_SECONDS=30
MOYUAN_MODELPORT_MAX_COMPLETION_TOKENS=512
MOYUAN_MODELPORT_ROUTING_PROFILE=balanced
# The Pi control plane hard-codes local_strict + internal for this local-Qwen path.
MOYUAN_AGENT_MODEL_MODE=modelport

# TypeScript/Pi control-plane discovery source: memory or python.
MOYUAN_DISCOVERY_MODE=python
# 18080 belongs to local-inference-stack on the maintained WSL setup.
MOYUAN_DISCOVERY_BASE_URL=http://127.0.0.1:18083
MOYUAN_CONTROL_HOST=127.0.0.1
MOYUAN_CONTROL_PORT=19090
MOYUAN_DATABASE_PATH=.runtime/commerce-agent.sqlite
