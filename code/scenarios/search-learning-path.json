{
  "name": "search-learning-path",
  "steps": [
    {
      "name": "rewrite-and-multi-source-recall",
      "action": "search",
      "payload": {
        "query": "苹果手机",
        "user_id": "u001",
        "page_size": 5,
        "filters": {
          "max_price": 7000
        }
      },
      "expect": {
        "query_rewritten": "iphone",
        "query_broad": false,
        "top_item": "p001",
        "recall_source_present": "brand_intent",
        "filter_reasons_contains": {
          "out_of_stock": 1
        }
      }
    },
    {
      "name": "broad-query-diversity",
      "action": "search",
      "payload": {
        "query": "手机",
        "user_id": "u001",
        "page_size": 8
      },
      "expect": {
        "query_broad": true,
        "min_items": 5,
        "recall_source_present": "broad_explore",
        "rerank_reason_present": "POSITION_CHANGED"
      }
    },
    {
      "name": "filter-and-price-sort",
      "action": "search",
      "payload": {
        "query": "手机",
        "user_id": "u001",
        "sort": "price_asc",
        "page_size": 10,
        "filters": {
          "categories": ["手机"],
          "max_price": 5000
        }
      },
      "expect": {
        "item_ids_prefix": ["p002", "p004", "p003"],
        "all_items_match": {
          "category": "手机"
        },
        "sorted_by": {
          "field": "price",
          "order": "asc"
        },
        "filter_reasons_contains": {
          "out_of_stock": 1,
          "above_max_price": 1,
          "category_mismatch": 1
        }
      }
    },
    {
      "name": "hot-fallback",
      "action": "search",
      "payload": {
        "query": "露营灯",
        "user_id": "u001",
        "page_size": 5
      },
      "expect": {
        "query_rewritten": "露营灯",
        "query_broad": false,
        "min_items": 5,
        "recall_source_present": "hot_fallback"
      }
    },
    {
      "name": "risk-query-stops-early",
      "action": "search",
      "payload": {
        "query": "假证",
        "user_id": "u001",
        "page_size": 5
      },
      "expect": {
        "query_blocked": true,
        "result_count": 0,
        "total": 0,
        "trace_stages": ["QUERY", "RESULT"]
      }
    }
  ]
}
