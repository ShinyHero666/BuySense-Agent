{
  "name": "search-basic",
  "steps": [
    {
      "name": "rewrite-filter-and-rank",
      "action": "search",
      "payload": {
        "query": "苹果手机",
        "user_id": "u001",
        "page_size": 5,
        "filters": {
          "max_price": 7000
        }
      },
      "expect": {
        "item_ids_contains": ["p001", "p002"],
        "item_ids_excludes": ["p016"],
        "min_items": 3,
        "trace_stages": [
          "QUERY",
          "RECALL",
          "FILTER",
          "FEATURE",
          "ROUGHRANK",
          "RANK",
          "RERANK",
          "RESULT"
        ]
      }
    }
  ]
}

