{
  "name": "moyuan-secondhand-business-case",
  "description": "Synthetic Moyuan teaching scenario; not a claim about a production platform.",
  "steps": [
    {
      "name": "platform-inspected-iphone-under-budget",
      "action": "search",
      "payload": {
        "query": "iphone",
        "user_id": "u001",
        "page_size": 5,
        "filters": {
          "categories": ["手机"],
          "inspection_grades": ["A", "B"],
          "min_battery_health": 85,
          "warranty_required": true,
          "max_price": 4000
        }
      },
      "expect": {
        "top_item": "p002",
        "item_ids_contains": ["p002"],
        "item_ids_excludes": ["p001", "p016", "p017"],
        "filter_reasons_contains": {
          "above_max_price": 1,
          "out_of_stock": 1,
          "inspection_not_passed": 1
        }
      }
    },
    {
      "name": "online-pre-inspection-quote",
      "action": "valuation",
      "payload": {
        "brand": "Apple",
        "model": "iPhone 13",
        "category": "手机",
        "storage_gb": 128,
        "age_months": 36,
        "condition_grade": "B",
        "battery_health": 90,
        "inspection_method": "door"
      },
      "expect": {
        "estimated_mid_between": [1800, 3000],
        "requires_inspection": true,
        "fields_equal": {
          "reference_source": "model_reference"
        }
      }
    },
    {
      "name": "declared-water-damage-needs-review",
      "action": "valuation",
      "payload": {
        "brand": "Apple",
        "model": "iPhone 13",
        "category": "手机",
        "storage_gb": 128,
        "age_months": 48,
        "condition_grade": "C",
        "battery_health": 78,
        "functional_issues": ["water_damage"],
        "inspection_method": "store"
      },
      "expect": {
        "estimated_mid_between": [300, 1500],
        "requires_inspection": true,
        "risk_flag_present": "MANUAL_REVIEW_REQUIRED"
      }
    },
    {
      "name": "recommendation-removes-unqualified-inventory",
      "action": "recommend",
      "payload": {
        "user_id": "u001",
        "size": 8,
        "exclude_seen": false
      },
      "expect": {
        "min_items": 5,
        "item_ids_excludes": ["p016", "p017"],
        "filter_reasons_contains": {
          "out_of_stock": 1,
          "inspection_not_passed": 1
        }
      }
    }
  ]
}
